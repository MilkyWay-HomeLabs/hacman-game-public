# Hacman Game App — environment variables (Vite)
# Copy to `.env` (dev) or `.env.production` (prod build) and adjust values.
# Only VITE_-prefixed variables are exposed to the client bundle. Never put secrets here.

# Base path the app is served from (must match the deployment location).
#   dev:  /dev/hacman/game/
#   test: /hacman/game/
VITE_BASE_PATH=/dev/hacman/game/

# Static resources host (images, etc.).
VITE_RESOURCES_URL=https://milkyway.test/resources

# Base URL of the Hacman REST API (no trailing slash).
# Endpoints are appended as `/v1/...` (e.g. `${VITE_API_BASE_URL}/v1/version`).
VITE_API_BASE_URL=https://milkyway.test/hacman/api

# URL the player is returned to after finishing a game (the Nebula gallery).
# Used as a fallback when `document.referrer` is empty or off-domain; `galleryId` is appended.
VITE_NEBULA_RETURN_URL=https://milkyway.test/nebula/app/
